      "battery_pack": [
        {
          "command": "MoveHome",
          "params": {}
        },
        {
          "command": "PickObject",
          "params": {
            "object": "battery"
          }
        },
        {
          "command": "PlaceObject",
          "params": {
            "location": "jig"
          }
        }
      ]
    },
    "auto_switch_to_automatic": false,
    "ros_bridge": {
      "host": "192.168.2.14",
      "port": 9090,
      "throttle_ms": 100
    }
  }
